# Copy to .env (never commit .env)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DBNAME
PORT=8080
# Comma-separated. Leave empty in development (any localhost port is allowed).
ALLOWED_ORIGINS=
UPLOAD_DIR=uploads
GROQ_API_KEY=your_groq_key
GROQ_MODEL=your_model_name
CASHFREE_APP_ID=your_cashfree_test_app_id
CASHFREE_SECRET_KEY=your_cashfree_test_secret
CASHFREE_ENV=sandbox
CASHFREE_CUSTOMER_PHONE=9999999999
PREMIUM_DEMO=false
